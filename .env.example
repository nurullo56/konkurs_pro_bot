# Telegram Bot Token (BotFather'dan olingan token)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Admin Telegram ID lari (vergul bilan ajratilgan)
ADMIN_IDS=123456789

# Konkurs sozlamalari
CONTEST_NAME=Pro Konkurs
PRIZE_TEXT=2 000 000 so'm
TOP_N=10
START_POINTS=5
REFERRAL_POINTS=1

# Database Configuration (PostgreSQL / SQLite)
# DB_TYPE: postgresql yoki sqlite
DB_TYPE=sqlite
POSTGRES_DSN=postgresql://postgres:password@localhost:5432/konkurs_db
DB_PATH=contest.db

# Redis Configuration (FSM Storage va Anti-flood uchun)
# Bo'sh qoldiring agar Redis ishlatilmasa
REDIS_URL=redis://localhost:6379/0

# Rate limit / Anti-flood (soniyalarda)
RATE_LIMIT=1.5

# Webhook sozlamalari (USE_WEBHOOK=true bo'lsa kerak)
USE_WEBHOOK=false
WEBHOOK_URL=https://yourdomain.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-to-a-random-string
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8001
